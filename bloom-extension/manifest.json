{
  "manifest_version": 3,
  "name": "Bloom for Desktop",
  "version": "1.0.0",
  "description": "Stop Instagram Reels doomscrolling. Reels your friends send still play.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Bloom",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
    "js": ["src/content/selectors.js", "src/content/main.js"],
    "css": ["src/content/bloom.css"],
    "run_at": "document_start"
  }]
}
